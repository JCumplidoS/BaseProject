# Supabase Auth - variables de servidor (no se exponen al navegador).
# Obtén los valores en: Supabase Dashboard > Project Settings > API Keys y Data API
# Usa la clave PUBLICA (publishable / anon), nunca la service_role / secret.
SUPABASE_URL=https://tu-proyecto.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_tu_clave_publica
